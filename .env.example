HOST=127.0.0.1
PORT=3000

# Integration modes: mock | live
MPESA_MODE=mock
COOPBANK_MODE=mock
NOTIFY_MODE=mock

# M-Pesa (required in live mode)
MPESA_BASE_URL=
MPESA_AUTH_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_PATH=/mpesa/stkpush/v1/processrequest
MPESA_CALLBACK_URL=http://127.0.0.1:3000/api/webhooks/mpesa
MPESA_CALLBACK_TOKEN=dev-mpesa-callback-token

# Coop Bank (required in live mode)
COOPBANK_BASE_URL=
COOPBANK_TOKEN_URL=
COOPBANK_CLIENT_ID=
COOPBANK_CLIENT_SECRET=
COOPBANK_COLLECTION_PATH=/payments/collect
COOPBANK_CALLBACK_TOKEN=dev-coop-callback-token

# Notification provider (required in live mode)
NOTIFY_BASE_URL=
NOTIFY_API_KEY=
NOTIFY_OTP_PATH=/otp/send
NOTIFY_TRANSACTION_PATH=/notifications/transaction
NOTIFY_SENDER_ID=CountyCore
OTP_TTL_SECONDS=300
