generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  passwordHash      String
  fullName          String
  role              String
  department        String?
  phone             String?
  avatar            String?
  twoFactorEnabled  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessions          UserSession[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(cuid())
  token       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  ipAddress   String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_sessions")
}

model SessionRecord {
  token     String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session_records")
}

model LedgerRecord {
  ledgerId  String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ledger_records")
}

model AuditRecord {
  id        String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("audit_records")
}

model OtpRecord {
  id        String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otp_records")
}

model NotificationRecord {
  id        String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_records")
}

model PaymentEventRecord {
  id        String   @id
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_event_records")
}

model AuthChallengeRecord {
  challengeId String   @id
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("auth_challenge_records")
}

model AppStateRecord {
  id        Int      @id @default(1)
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_state_records")
}
